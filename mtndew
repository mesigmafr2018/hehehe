local function unanchoredClaimAllParts(partsList)
	local realRoot = unanchoredGetRealRoot()
	if not realRoot then return end
	unanchoredDisableRealCollisions()
	if type(partsList) ~= "table" or #partsList == 0 then
		unanchoredClearPhysicsRep(realRoot)
		if UnanchoredReanimator.RootBelowRig then
			unanchoredParkRealRootBelowRig(realRoot)
		end
		return
	end

	
	local primary = nil
	local primaryIndex = nil
	for i, p in ipairs(partsList) do
		if p and p.Parent and not p.Anchored and not unanchoredOwnedCached(p) then
			primary = p
			primaryIndex = i
			break
		end
	end
	if not primary then
		_unanchoredClaimIndex = (_unanchoredClaimIndex % #partsList) + 1
		primaryIndex = _unanchoredClaimIndex
		primary = partsList[primaryIndex]
	else
		_unanchoredClaimIndex = primaryIndex
	end
	if not (primary and primary.Parent) then return end

	local function claimOn(part)
		if not (part and part.Parent) then return end
		unanchoredClaimPhysicsRep(realRoot, part)
		pcall(function()
			realRoot.CFrame = part.CFrame
			realRoot.AssemblyLinearVelocity = Vector3.zero
			realRoot.AssemblyAngularVelocity = Vector3.zero
		end)
		unanchoredWake(part)
		unanchoredVelocityReclaim(part)
		pcall(function()
			if part.RootPriority ~= 127 then part.RootPriority = 127 end
		end)
	end

	
	claimOn(primary)

	
	local ordered = {}
	for _, p in ipairs(partsList) do
		if p and p ~= primary and p.Parent and not unanchoredOwnedCached(p) then
			table.insert(ordered, p)
		end
	end
	for _, p in ipairs(partsList) do
		if p and p ~= primary and p.Parent and unanchoredOwnedCached(p) then
			table.insert(ordered, p)
		end
	end
	for _, part in ipairs(ordered) do
		claimOn(part)
	end

	
	claimOn(primary)

	
	
	if UnanchoredReanimator.RootBelowRig then
		local anyLost = false
		for _, p in ipairs(partsList) do
			if p and p.Parent and not p.Anchored and not unanchoredOwnedCached(p) then
				anyLost = true
				break
			end
		end
		if not anyLost then
			unanchoredParkRealRootBelowRig(realRoot)
		end
		
	end
end

