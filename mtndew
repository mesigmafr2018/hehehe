function UnanchoredReanimator.Start()
	Reanimate.Starting = true

	local InitCFrame = nil
	if Player.Character then
		local h = Player.Character:FindFirstChildOfClass("Humanoid")
		if h and h.RootPart then
			InitCFrame = h.RootPart.CFrame
		end
	end

	if not Reanimate.Character then
		Reanimate.CreateCharacter(InitCFrame)
	end
	local RC = Reanimate.Character
	if not RC then
		Util.UINotify("Unanchored Reanimator: failed to create character")
		Reanimate.Starting = false
		return
	end

	if UnanchoredReanimator.StayInvisible then
		unanchoredSetupInvisible()
	end

	Reanimate.Starting = false
	UnanchoredReanimator.Running = true
	UnanchoredReanimator.Parts = {}
	table.clear(_lostOwnSince)

	local lastScan = 0
	local SCAN_INTERVAL = 0.45
	local LOST_DROP_AFTER = 4.0  

	local simConn
	if type(sethiddenproperty) == "function" then
		simConn = RunService.Heartbeat:Connect(function()
			if not UnanchoredReanimator.Running then return end
			pcall(sethiddenproperty, Player, "SimulationRadius", math.huge)
			pcall(function()
				if type(setsimulationradius) == "function" then
					setsimulationradius(math.huge)
				end
			end)
		end)
	end

	local camConn
	
	
	camConn = RunService.RenderStepped:Connect(function()
		if not UnanchoredReanimator.Running then return end
		local rc = Reanimate.Character
		if not rc then return end
		local hum = rc:FindFirstChildOfClass("Humanoid")
		local root = rc:FindFirstChild("HumanoidRootPart")
		pcall(function()
			if hum and Camera.CameraSubject ~= hum then
				Camera.CameraSubject = hum
			elseif (not hum) and root and Camera.CameraSubject ~= root then
				Camera.CameraSubject = root
			end
			if Camera.CameraType ~= Enum.CameraType.Custom then
				Camera.CameraType = Enum.CameraType.Custom
			end
		end)
	end)
	
	pcall(function()
		local rc = Reanimate.Character
		local hum = rc and rc:FindFirstChildOfClass("Humanoid")
		if hum then Camera.CameraSubject = hum end
	end)

	local conn
	conn = RunService.Heartbeat:Connect(function(dt)
		local unanchoredFamily = (Reanimate.Current == MountainDewReanimator)
			or (Reanimate.Current == UnanchoredReanimator)
		if Reanimate.Stopping or not UnanchoredReanimator.Running or not unanchoredFamily then
			if conn then conn:Disconnect() end
			if simConn then pcall(function() simConn:Disconnect() end) end
			if camConn then pcall(function() camConn:Disconnect() end) end
			
			local realChar = Player.Character
			local realRoot = realChar and realChar:FindFirstChild("HumanoidRootPart")
			if realRoot then unanchoredClearPhysicsRep(realRoot) end
			unanchoredCleanupInvisible()
			unanchoredDestroyFakeTool(Reanimate.Character)
			for _, extra in pairs(UnanchoredReanimator.Extras or {}) do
				extra.Part = nil
				extra._assembly = nil
				extra._rel = nil
			end
			UnanchoredReanimator.SwordPart = nil
			UnanchoredReanimator.Running = false
			Reanimate.Stopping = false
			return
		end

		local source = RC
		if not source or not source.Parent then
			source = Reanimate.Character
			RC = source
		end
		if not source then return end

		
		pcall(function()
			local hum = source:FindFirstChildOfClass("Humanoid")
			if hum then
				Camera.CameraSubject = hum
			end
		end)

		local scale = Reanimate.CharacterScale or 1
		local offsetY = UnanchoredReanimator.OffsetY or 0
		local range = math.max(0, tonumber(UnanchoredReanimator.Range) or 80)
		
		if Reanimate.Current == MountainDewReanimator then
			UnanchoredReanimator.CanMode = true
			UnanchoredReanimator.RootBelowRig = MountainDewReanimator.RootBelowRig
			UnanchoredReanimator.RootBelowOffset = MountainDewReanimator.RootBelowOffset or 10
			UnanchoredReanimator.FlingEnabled = MountainDewReanimator.FlingEnabled
			UnanchoredReanimator.FlingPower = MountainDewReanimator.FlingPower
			UnanchoredReanimator.FlingMethod = MountainDewReanimator.FlingMethod or 0
			UnanchoredReanimator.OffsetY = MountainDewReanimator.OffsetY
			UnanchoredReanimator.Range = MountainDewReanimator.Range
			for _, extra in pairs(UnanchoredReanimator.Extras or {}) do
				extra.Enabled = false
			end
		end
		
		local maxParts = UnanchoredReanimator.CanMode and 6 or 13

		local center = Vector3.zero
		local hrp = source:FindFirstChild("HumanoidRootPart")
		if hrp then
			center = hrp.Position
		elseif Camera then
			center = Camera.CFrame.Position
		end

		local now = tick()
		if now - lastScan > SCAN_INTERVAL or #UnanchoredReanimator.Parts == 0 then
			lastScan = now
			local exclude = { Player.Character, RC }
			local partSize = UnanchoredReanimator.PartSize or 1
			local found
			if UnanchoredReanimator.CanMode then
				-- Folder only (AllMountainDew) + can size — no world radius grab
				found = unanchoredCollectCansFromSource(maxParts, {})
			else
				found = collectUnanchoredParts(center, range, maxParts, exclude, partSize)
			end
			local newList = {}
			local used = {}
			for _, oldp in ipairs(UnanchoredReanimator.Parts) do
				if oldp and oldp.Parent and not oldp.Anchored and not used[oldp] then
					if unanchoredPartMatchesSize(oldp, partSize) then
						table.insert(newList, oldp)
						used[oldp] = true
						if #newList >= maxParts then break end
					end
				end
			end
			for _, p in ipairs(found) do
				if #newList >= maxParts then break end
				if not used[p] then
					table.insert(newList, p)
					used[p] = true
				end
			end
			UnanchoredReanimator.Parts = newList
		end

		
		do
			local exclude = { Player.Character, source }
			local doGrab = (now - lastScan) < 0.05 
			
			_unanchoredExtraGrabAt = _unanchoredExtraGrabAt or 0
			local shouldGrab = (now - _unanchoredExtraGrabAt) >= 0.5
			if shouldGrab then _unanchoredExtraGrabAt = now end
			for _, extra in pairs(UnanchoredReanimator.Extras or {}) do
				if not extra.Enabled then
					extra.Part = nil
					extra._assembly = nil
				else
					if extra.Part and (not extra.Part.Parent or extra.Part.Anchored) then
						extra.Part = nil
						extra._assembly = nil
					end
					if shouldGrab and (not extra.Part) and extra.Auto ~= false then
						local found = unanchoredFindExtraPart(extra, center, range, exclude)
						if found then
							extra.Part = found
							extra._assembly = nil
							extra._rel = nil
							extra._assemblyAt = 0
						end
					end
					if extra.Part and not extra._assembly then
						extra._assembly = unanchoredCollectAssemblyParts(extra.Part)
						extra._rel = {}
						for _, mate in ipairs(extra._assembly) do
							extra._rel[mate] = unanchoredCaptureRel(extra.Part, mate)
							unanchoredForceNoCollide(mate)
						end
						extra._assemblyAt = now
					end
				end
			end
			UnanchoredReanimator.SwordPart = (UnanchoredReanimator.Extras.Sword and UnanchoredReanimator.Extras.Sword.Part) or nil
		end

		
		local needFakeTool = false
		for _, extra in pairs(UnanchoredReanimator.Extras or {}) do
			unanchoredDriveExtra(extra, source)
			if extra.Enabled and extra.Part and (extra.Name == "Sword" or extra.Name == "Gun") then
				needFakeTool = true
			end
		end
		if not needFakeTool then
			unanchoredDestroyFakeTool(source)
		end
		
		if needFakeTool then
			local fake = source:FindFirstChild("faketool")
			if fake and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
				if not fake:GetAttribute("_Uhhhhhh_Swing") then
					fake:SetAttribute("_Uhhhhhh_Swing", true)
					local toolanim = Instance.new("StringValue")
					toolanim.Name = "toolanim"
					toolanim.Value = (UnanchoredReanimator.Extras.Sword and UnanchoredReanimator.Extras.Sword.Part) and "Lunge" or "Slash"
					toolanim.Parent = fake
					Debris:AddItem(toolanim, 0.35)
					task.delay(0.35, function()
						if fake then fake:SetAttribute("_Uhhhhhh_Swing", nil) end
					end)
				end
			end
		end
		local swordPart = UnanchoredReanimator.SwordPart

		local parts = UnanchoredReanimator.Parts
		local hasExtra = false
		for _, extra in pairs(UnanchoredReanimator.Extras or {}) do
			if extra.Part and extra.Part.Parent and not extra.Part.Anchored then
				hasExtra = true
				break
			end
		end
		
		if #parts == 0 and not hasExtra then return end

		local realChar = Player.Character
		local realRoot = realChar and realChar:FindFirstChild("HumanoidRootPart")

		local keep = {}
		local claimTarget = nil 

		for i, part in ipairs(parts) do
			if part and part.Parent and not part.Anchored then
				local owned = unanchoredOwnedCached(part)
				unanchoredWake(part)

				unanchoredForceNoCollide(part)
				if owned then
					_lostOwnSince[part] = nil
					if not claimTarget then claimTarget = part end
					local slot = ((i - 1) % (UnanchoredReanimator.CanMode and 6 or 13)) + 1
					local cf = getUnanchoredSlotCFrame(slot, source, scale)
					if cf then
						local targetCF = CFrame.new(cf.Position + Vector3.new(0, offsetY, 0)) * (cf - cf.Position)
						pcall(function()
							part.CFrame = targetCF
							part.AssemblyLinearVelocity = unanchoredNetHoldVelocity()
							part.AssemblyAngularVelocity = Vector3.zero
							part.CanCollide = false
						end)
					end
					table.insert(keep, part)
				else
					if not _lostOwnSince[part] then
						_lostOwnSince[part] = now
					end
					unanchoredVelocityReclaim(part)
					unanchoredForceNoCollide(part)
					if not claimTarget then claimTarget = part end 
					
					
					local flingProtect = UnanchoredReanimator.FlingEnabled
						and UnanchoredReanimator.FlingTargets[1] ~= nil
					if flingProtect or (now - _lostOwnSince[part]) < LOST_DROP_AFTER then
						table.insert(keep, part)
					else
						_lostOwnSince[part] = nil
						_ownVerdict[part] = nil
						_ownVerdictAt[part] = nil
					end
				end
			else
				if part then
					_lostOwnSince[part] = nil
					_ownVerdict[part] = nil
					_ownVerdictAt[part] = nil
				end
			end
		end
		UnanchoredReanimator.Parts = keep

		
		
		
		
		
		local anyFlingActive = UnanchoredReanimator.FlingEnabled
			and UnanchoredReanimator.FlingTargets[1] ~= nil
		local limbFlingActive = anyFlingActive and UnanchoredReanimator.FlingMethod == 1

		
		if Player.Character and Player.Character ~= _unanchoredColChar then
			table.clear(_unanchoredColSaved)
			_unanchoredColChar = nil
			unanchoredDisableRealCollisions()
			_unanchoredColRefreshAt = now
		end
		if Player.Character and (now - (_unanchoredColRefreshAt or 0)) > 1.0 then
			_unanchoredColRefreshAt = now
			unanchoredDisableRealCollisions()
		end

		if anyFlingActive then
			if limbFlingActive then
				
				pcall(function() workspace.FallenPartsDestroyHeight = 0/0 end)
			end
			
			for _, part in ipairs(keep) do
				if part and part.Parent and not part.Anchored then
					unanchoredWake(part)
					_lostOwnSince[part] = nil
					pcall(function()
						if part.RootPriority ~= 127 then part.RootPriority = 127 end
						
						
						if not (UnanchoredReanimator.FlingMethod == 0) then
							part.AssemblyLinearVelocity = unanchoredNetHoldVelocity()
						end
					end)
				end
			end
			for _, extra in pairs(UnanchoredReanimator.Extras or {}) do
				local ep = extra.Part
				if ep and ep.Parent and not ep.Anchored then
					unanchoredWake(ep)
					_lostOwnSince[ep] = nil
					pcall(function()
						if ep.RootPriority ~= 127 then ep.RootPriority = 127 end
						if not (UnanchoredReanimator.FlingMethod == 0) then
							ep.AssemblyLinearVelocity = unanchoredNetHoldVelocity()
						end
					end)
				end
			end
			if UnanchoredReanimator.RootBelowRig then
				unanchoredParkRealRootBelowRig()
			end
		else
			local claimList = {}
			for _, p in ipairs(keep) do
				table.insert(claimList, p)
			end
			
			for _, extra in pairs(UnanchoredReanimator.Extras or {}) do
				local mates = extra._assembly
				if (not mates or #mates == 0) and extra.Part then
					mates = unanchoredCollectAssemblyParts(extra.Part)
				end
				for _, ep in ipairs(mates or {}) do
					if ep and ep.Parent and not ep.Anchored then
						local already = false
						for _, p in ipairs(claimList) do
							if p == ep then already = true break end
						end
						if not already then
							table.insert(claimList, 1, ep)
						end
					end
				end
			end
			unanchoredClaimAllParts(claimList)
		end

		
		unanchoredProcessFling(keep)
	end)

	while UnanchoredReanimator.Running and not Reanimate.Stopping do
		task.wait(0.1)
	end
	if conn then pcall(function() conn:Disconnect() end) end
	if simConn then pcall(function() simConn:Disconnect() end) end
	if camConn then pcall(function() camConn:Disconnect() end) end
	local realChar = Player.Character
	local realRoot = realChar and realChar:FindFirstChild("HumanoidRootPart")
	if realRoot then unanchoredClearPhysicsRep(realRoot) end
	unanchoredCleanupInvisible()
	UnanchoredReanimator.Running = false
	UnanchoredReanimator.Parts = {}
	UnanchoredReanimator.SwordPart = nil
	if MountainDewReanimator then MountainDewReanimator.Running = false end
	table.clear(_lostOwnSince)
	Reanimate.Stopping = false
end

