local function unanchoredExtraMatches(part, extra)
	if not (part and part.Parent and part:IsA("BasePart") and extra) then return false end
	local n = string.lower(part.Name)
	local pn = part.Parent and string.lower(part.Parent.Name) or ""
	if extra.Name == "Sword" then
		if n == "sword" or pn == "sword" then return true end
		if n:find("sword", 1, true) or pn:find("sword", 1, true) then return true end
	end
	if extra.Name == "Gun" then
		if n == "gun" or pn == "gun" then return true end
		if n:find("gun", 1, true) or pn:find("gun", 1, true) then return true end
		if n:find("pistol", 1, true) or n:find("rifle", 1, true) then return true end
	end
	if extra.Name == "Fire" then
		if n == "fire emitter" or n == "fireemitter" or pn == "fire emitter" or pn == "fireemitter" then return true end
		if n:find("fire", 1, true) or pn:find("fire", 1, true) then return true end
	end
	for _, pat in ipairs(extra.Patterns or {}) do
		if n:find(pat, 1, true) or pn:find(pat, 1, true) then
			return true
		end
	end
	if n == "handle" and pn ~= "" then
		for _, pat in ipairs(extra.Patterns or {}) do
			if pn:find(pat, 1, true) then return true end
		end
		if extra.Name == "Sword" and pn:find("sword", 1, true) then return true end
		if extra.Name == "Gun" and pn:find("gun", 1, true) then return true end
	end
	return false
end

local function unanchoredIsAssignedExtraPart(part)
	for _, extra in pairs(UnanchoredReanimator.Extras or {}) do
		if extra.Part == part then return true end
		if extra._assembly then
			for _, m in ipairs(extra._assembly) do
				if m == part then return true end
			end
		end
	end
	return false
end

local function unanchoredIsSwordPart(part)
	if not (part and part:IsA("BasePart")) then return false end
	if unanchoredIsAssignedExtraPart(part) then return true end
	for _, extra in pairs(UnanchoredReanimator.Extras or {}) do
		if extra.Enabled and unanchoredExtraMatches(part, extra) then return true end
	end
	return false
end

local function unanchoredPartTakenByOtherExtra(part, selfExtra)
	for _, other in pairs(UnanchoredReanimator.Extras or {}) do
		if other ~= selfExtra then
			if other.Part == part then return true end
			if other._assembly then
				for _, m in ipairs(other._assembly) do
					if m == part then return true end
				end
			end
		end
	end
	return false
end

local function unanchoredPickPrimaryFromModel(model, extra)
	if not model then return nil end
	local want = string.lower(extra.Name or "")
	local exact, handle, any = nil, nil, nil
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and not d.Anchored then
			local ln = string.lower(d.Name)
			if ln == want then exact = exact or d end
			if ln == "handle" then handle = handle or d end
			if unanchoredExtraMatches(d, extra) then any = any or d end
		end
	end
	return exact or handle or any
end

local function unanchoredFindExtraPart(extra, center, range, excludeChars)
	if not extra then return nil end
	range = math.max(0, tonumber(range) or 80)
	center = center or Vector3.zero

	local best, bestScore = nil, math.huge

	local function consider(p)
		if not (p and p.Parent and p:IsA("BasePart") and not p.Anchored) then return end
		if not unanchoredExtraMatches(p, extra) then return end
		if unanchoredPartTakenByOtherExtra(p, extra) then return end
		local model = p:FindFirstAncestorOfClass("Model")
		if model and Players:GetPlayerFromCharacter(model) then return end
		
		if model then
			local primary = unanchoredPickPrimaryFromModel(model, extra)
			if primary then p = primary end
		end
		local d = (p.Position - center).Magnitude
		local ln = string.lower(p.Name)
		local isExact = (extra.Name == "Sword" and ln == "sword")
			or (extra.Name == "Gun" and ln == "gun")
			or (extra.Name == "Fire" and (ln == "fire emitter" or ln == "fireemitter"))
		if (not isExact) and range > 0 and d > math.max(range * 2, 120) then return end
		local exact = 0
		if extra.Name == "Sword" and ln == "sword" then exact = -5000 end
		if extra.Name == "Gun" and ln == "gun" then exact = -5000 end
		if extra.Name == "Fire" and (ln == "fire emitter" or ln == "fireemitter") then exact = -5000 end
		local score = d + exact
		if score < bestScore then
			bestScore = score
			best = p
		end
	end

	
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local exclude = {}
	if excludeChars then
		for _, c in ipairs(excludeChars) do
			if c then table.insert(exclude, c) end
		end
	end
	if workspace.Terrain then table.insert(exclude, workspace.Terrain) end
	params.FilterDescendantsInstances = exclude
	params.MaxParts = 512
	local ok, parts = pcall(function()
		return workspace:GetPartBoundsInRadius(center, math.max(range, 50), params)
	end)
	if ok and type(parts) == "table" then
		for _, p in ipairs(parts) do
			consider(p)
		end
	end

	
	
	return best
end

local function unanchoredFindSwordPart(center, range, excludeChars)
	local ex = UnanchoredReanimator.Extras and UnanchoredReanimator.Extras.Sword
	return unanchoredFindExtraPart(ex, center, range, excludeChars)
end

