function MountainDewReanimator.Fling(target, duration)
	if not MountainDewReanimator.FlingEnabled then return false end
	
	for _, v in MountainDewReanimator.FlingTargets do
		if v.Target == target then return false end
	end
	if MountainDewReanimator._TempNotFling[target] then return false end
	MountainDewReanimator._TempNotFling[target] = true
	task.delay(1, function() MountainDewReanimator._TempNotFling[target] = nil end)
	local entry = { Target = target, Duration = duration }
	table.insert(MountainDewReanimator.FlingTargets, entry)
	table.insert(UnanchoredReanimator.FlingTargets, entry)
	return true
end

