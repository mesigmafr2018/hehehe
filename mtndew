function UnanchoredReanimator.Fling(target, duration)
	if not UnanchoredReanimator.FlingEnabled then return false end
	if not target then return false end
	for _,v in UnanchoredReanimator.FlingTargets do
		if v.Target == target then return false end
	end
	if target == Reanimate.Character or target == Player.Character then return false end
	if typeof(target) == "Instance" then
		if UnanchoredReanimator._TempNotFling[target] then return end
		UnanchoredReanimator._TempNotFling[target] = true
		task.delay(1, function() UnanchoredReanimator._TempNotFling[target] = nil end)
		if target:IsA("Model") then
			pcall(function()
				local h = Util.Instance("Highlight")
				h.Adornee = target
				h.FillColor = Color3.new(1, 0, 0)
				h.OutlineColor = Color3.new(1, 0, 0)
				h.FillTransparency = 0.5
				h.OutlineTransparency = 0
				h.Parent = target
				TweenService:Create(h, TweenInfo.new(3), {
					FillTransparency = 1,
					OutlineTransparency = 1,
				}):Play()
				game.Debris:AddItem(h, 3)
			end)
		end
	end
	table.insert(UnanchoredReanimator.FlingTargets, { Target = target, Duration = duration })
	return true
end

local function unanchoredFlingResolvePart(target)
	if typeof(target) == "Instance" then
		if target:IsA("Model") then
			return target:FindFirstChild("HumanoidRootPart")
				or target.PrimaryPart
				or target:FindFirstChildWhichIsA("BasePart")
		end
		if target:IsA("BasePart") then return target end
		if target:IsA("Humanoid") and target.Parent then
			return target.Parent:FindFirstChild("HumanoidRootPart")
				or target.Parent:FindFirstChildWhichIsA("BasePart")
		end
	end
	return nil
end

local function unanchoredFlingCatalyst(flingtarget, ownedParts)
	local targetPart = unanchoredFlingResolvePart(flingtarget.Target)
	if not targetPart or not targetPart.Parent then return false end
	local power = math.max(tonumber(UnanchoredReanimator.FlingPower) or 1500, 50)
	local k = power / 1500
	local pos = targetPart.Position

	for _, part in ipairs(ownedParts) do
		if part and part.Parent and not part.Anchored then
			unanchoredWake(part)
			
			_lostOwnSince[part] = nil
			_ownVerdict[part] = nil
			_ownVerdictAt[part] = nil
			pcall(function()
				if part.RootPriority ~= 127 then part.RootPriority = 127 end
				part.CFrame = targetPart.CFrame * CFrame.new(
					(math.random() - 0.5) * 2,
					(math.random() - 0.5) * 2,
					(math.random() - 0.5) * 2
				)
				part.AssemblyLinearVelocity = Vector3.new(
					(math.random() - 0.5) * 200000 * k,
					150000 * k + (math.random() - 0.5) * 50000,
					(math.random() - 0.5) * 200000 * k
				)
				part.AssemblyAngularVelocity = Vector3.new(
					(math.random() - 0.5) * 9e18,
					(math.random() - 0.5) * 9e18,
					(math.random() - 0.5) * 9e18
				)
			end)
		end
	end

	
	local function burst(obj)
		if not (obj and obj:IsA("BasePart") and not obj.Anchored and obj ~= workspace.Terrain) then return end
		if obj:IsDescendantOf(Player.Character) then return end
		if Reanimate.Character and obj:IsDescendantOf(Reanimate.Character) then return end
		pcall(function()
			local dir = obj.Position - pos
			dir = dir.Magnitude > 0.01 and dir.Unit or Vector3.new(0, 1, 0)
			obj.AssemblyLinearVelocity = obj.AssemblyLinearVelocity
				+ dir * (2000000 * k) + Vector3.new(0, 700000 * k, 0)
			obj.AssemblyAngularVelocity = obj.AssemblyAngularVelocity + Vector3.new(
				(math.random() - 0.5) * 2500000 * k,
				(math.random() - 0.5) * 2500000 * k,
				(math.random() - 0.5) * 2500000 * k
			)
		end)
	end
	burst(targetPart)
	local model = targetPart:FindFirstAncestorOfClass("Model")
	if model then
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("BasePart") then burst(d) end
		end
	end
	return true
end

local function unanchoredFlingLimbRoot(flingtarget)
	local Character = Player.Character
	local RootPart = Character and Character:FindFirstChild("HumanoidRootPart")
	local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
	if not (RootPart and Humanoid) then return false end

	
	local flingcf, flinged = Util.PredictionFling(flingtarget.Target)
	if flinged then return false end

	
	if not RootPart:IsGrounded() then
		
		RootPart.CFrame = flingcf + Vector3.new(0, 0, math.random(0, 1) * 0.005)
		RootPart.Velocity, RootPart.RotVelocity = Vector3.new(0, -16384, 0), Vector3.one * 16384
		
		pcall(sethiddenproperty, RootPart, "PhysicsRepRootPart",
			Reanimate.UsePhysicsRepRootPart and Util.PredictionFlingPart(flingtarget.Target) or nil)
		
		local fp = Util.PredictionFlingPart(flingtarget.Target)
		if fp and Reanimate.UsePhysicsRepRootPart then
			unanchoredSetPhysicsRepRootRef(RootPart, fp)
		end
	else
		
		pcall(function()
			Humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
		end)
	end

	
	pcall(sethiddenproperty, Humanoid, "NetworkHumanoidState", Enum.HumanoidStateType.Flying.Value)

	return true
end

local function unanchoredProcessFling(ownedParts)
	if not UnanchoredReanimator.FlingEnabled then return end
	local t = os.clock()
	local flingtarget = UnanchoredReanimator.FlingTargets[1]
	if not flingtarget then return end

	local function clearFlingPhysics()
		local realRoot = unanchoredGetRealRoot()
		if realRoot then
			pcall(sethiddenproperty, realRoot, "PhysicsRepRootPart", nil)
			unanchoredClearPhysicsRepRootRef(realRoot)
		end
	end

	if flingtarget.Time then
		if t > flingtarget.Time then
			table.remove(UnanchoredReanimator.FlingTargets, 1)
			clearFlingPhysics()
			return
		end
	else
		local dur = flingtarget.Duration
		if not dur then
			if UnanchoredReanimator.FlingMethod == 1 then
				dur = (Reanimate.UsePhysicsRepRootPart and 0.5 or 2)
			else
				dur = 1.2
			end
		end
		flingtarget.Time = t + dur
	end

	if UnanchoredReanimator.FlingMethod == 1 then
		local ok = unanchoredFlingLimbRoot(flingtarget)
		if not ok then
			table.remove(UnanchoredReanimator.FlingTargets, 1)
			clearFlingPhysics()
		end
	else
		local ok = unanchoredFlingCatalyst(flingtarget, ownedParts or UnanchoredReanimator.Parts)
		if not ok then
			table.remove(UnanchoredReanimator.FlingTargets, 1)
			clearFlingPhysics()
		end
	end
end

