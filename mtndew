local function getUnanchoredSlotCFrame(slot, char, scale)
	if not char then return CFrame.new() end
	scale = scale or 1
	local now = tick()
	local wantCan = not not UnanchoredReanimator.CanMode
	if _unanchoredSlotCache.char ~= char or _unanchoredSlotCache.scale ~= scale
		or _unanchoredSlotCache.canMode ~= wantCan
		or not _unanchoredSlotCache.cfs[1]
		or (now - (_unanchoredSlotCache.at or 0)) > 0.016 then
		if wantCan then
			unanchoredRefreshCanSlotCache(char, scale)
		else
			unanchoredRefreshSlotCache(char, scale)
			_unanchoredSlotCache.canMode = false
		end
		_unanchoredSlotCache.at = now
	end
	local cfs = _unanchoredSlotCache.cfs
	local n = #cfs
	if n < 1 then return CFrame.new() end
	return cfs[((slot - 1) % n) + 1] or CFrame.new()
end

