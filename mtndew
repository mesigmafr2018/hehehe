local _noCollideHooked = setmetatable({}, {__mode = "k"})
local function unanchoredForceNoCollide(part)
	if not (part and part:IsA("BasePart")) then return end
	pcall(function() part.CanCollide = false end)
	if not _noCollideHooked[part] then
		_noCollideHooked[part] = true
		pcall(function()
			part:GetPropertyChangedSignal("CanCollide"):Connect(function()
				if part and part.Parent and part.CanCollide then
					pcall(function() part.CanCollide = false end)
				end
			end)
		end)
	end
end

local function unanchoredIsWeldedToOthers(part)
	if not (part and part:IsA("BasePart")) then return false end
	local ok, mates = pcall(function() return part:GetConnectedParts(false) end)
	if ok and type(mates) == "table" then
		for _, m in ipairs(mates) do
			if m and m ~= part and m:IsA("BasePart") and not m.Anchored then
				return true
			end
		end
	end
	local hasWeld = false
	pcall(function()
		for _, c in ipairs(part:GetChildren()) do
			if c:IsA("Weld") or c:IsA("WeldConstraint") or c:IsA("ManualWeld") or c:IsA("Snap") then
				local o0, o1 = c.Part0, c.Part1
				if (o0 and o0 ~= part) or (o1 and o1 ~= part) then
					hasWeld = true
					break
				end
			end
		end
	end)
	return hasWeld
end

local function unanchoredCollectAssemblyParts(primary)
	local list, seen = {}, {}
	if not (primary and primary:IsA("BasePart")) then return list end
	local function add(p)
		if p and p:IsA("BasePart") and p.Parent and not p.Anchored and not seen[p] then
			seen[p] = true
			table.insert(list, p)
		end
	end
	add(primary)
	pcall(function()
		for _, m in ipairs(primary:GetConnectedParts(true) or {}) do add(m) end
	end)
	local model = primary:FindFirstAncestorOfClass("Model")
	if model then
		for _, d in ipairs(model:GetDescendants()) do add(d) end
	end
	return list
end

local function unanchoredCaptureRel(primary, mate)
	if not (primary and mate) or primary == mate then return CFrame.new() end
	local ok, rel = pcall(function() return primary.CFrame:ToObjectSpace(mate.CFrame) end)
	return (ok and rel) or CFrame.new()
end

local function unanchoredDriveExtra(extra, reanimChar)
	if not (extra and extra.Enabled and extra.Part and extra.Part.Parent and not extra.Part.Anchored) then
		extra._assembly = nil
		extra._rel = nil
		return
	end
	local primary = extra.Part
	local toolGrip = CFrame.new(extra.OffX or 0, extra.OffY or 0, extra.OffZ or 0)
		* CFrame.Angles(math.rad(extra.RotX or 0), math.rad(extra.RotY or 0), math.rad(extra.RotZ or 0))

	
	local hasActiveOverride = false
	do
		local overrides = HatReanimator and HatReanimator.HatCFrameOverride
		if type(overrides) == "table" then
			for _, data in ipairs(overrides) do
				if data and not data.Disable and data.Group == extra.Name then
					hasActiveOverride = true
					break
				end
			end
		end
	end
	if not hasActiveOverride and (extra.Name == "Sword" or extra.Name == "Gun") then
		unanchoredEnsureFakeTool(reanimChar, toolGrip)
	end
	local cf, parked = unanchoredExtraTargetCFrame(reanimChar, extra)
	if not cf then return end
	extra._parked = parked and true or false

	if not extra._assembly or tick() - (extra._assemblyAt or 0) > 2.0 then
		extra._assembly = unanchoredCollectAssemblyParts(primary)
		extra._rel = extra._rel or {}
		for _, mate in ipairs(extra._assembly) do
			if extra._rel[mate] == nil then
				extra._rel[mate] = unanchoredCaptureRel(primary, mate)
			end
		end
		extra._assemblyAt = tick()
	end

	for _, mate in ipairs(extra._assembly or {primary}) do
		if mate and mate.Parent and not mate.Anchored then
			unanchoredForceNoCollide(mate)
			unanchoredWake(mate)
			if unanchoredOwnedCached(mate) then
				_lostOwnSince[mate] = nil
				pcall(function()
					if mate.RootPriority ~= 127 then mate.RootPriority = 127 end
				end)
			else
				if not _lostOwnSince[mate] then _lostOwnSince[mate] = tick() end
				unanchoredVelocityReclaim(mate)
			end
		end
	end

	pcall(function()
		if primary.RootPriority ~= 127 then primary.RootPriority = 127 end
		primary.CFrame = cf
		primary.AssemblyLinearVelocity = unanchoredNetHoldVelocity()
		primary.AssemblyAngularVelocity = Vector3.zero
		primary.CanCollide = false
	end)
	for _, mate in ipairs(extra._assembly or {}) do
		if mate and mate ~= primary and mate.Parent and not mate.Anchored then
			local rel = (extra._rel and extra._rel[mate]) or CFrame.new()
			pcall(function()
				mate.CFrame = cf * rel
				mate.AssemblyLinearVelocity = unanchoredNetHoldVelocity()
				mate.AssemblyAngularVelocity = Vector3.zero
				mate.CanCollide = false
			end)
		end
	end
end

local function unanchoredIsMountainDewFolderPart(part)
	if not (part and part.Parent) then return false end
	local folder = workspace:FindFirstChild("AllMountainDew")
	if not folder then return false end
	return part:IsDescendantOf(folder)
end

local function unanchoredPartMatchesCanSize(part)
	if not (part and part:IsA("BasePart")) then return false end
	local tol = 0.15
	local s = part.Size
	local cs = UnanchoredReanimator.CanSize or Vector3.new(1, 1.8, 1)
	local dims = {s.X, s.Y, s.Z}
	table.sort(dims)
	local wantDims = {cs.X, cs.Y, cs.Z}
	table.sort(wantDims)
	return math.abs(dims[1] - wantDims[1]) <= tol
		and math.abs(dims[2] - wantDims[2]) <= tol
		and math.abs(dims[3] - wantDims[3]) <= tol
end

local function unanchoredPartMatchesSize(part, want)
	if not (part and part:IsA("BasePart")) then return false end
	if UnanchoredReanimator.CanMode then
		-- cans: must be under AllMountainDew AND size ~1x1.8x1
		return unanchoredIsMountainDewFolderPart(part) and unanchoredPartMatchesCanSize(part)
	end
	local tol = 0.12
	local s = part.Size
	want = tonumber(want) or 1
	if want <= 0 then return true end
	return math.abs(s.X - want) <= tol
		and math.abs(s.Y - want) <= tol
		and math.abs(s.Z - want) <= tol
end

local function unanchoredIsCanPart(part)
	if not (part and part:IsA("BasePart") and not part.Anchored) then return false end
	return unanchoredIsMountainDewFolderPart(part) and unanchoredPartMatchesCanSize(part)
end

-- Only workspace.AllMountainDew (size-checked cans)
local function unanchoredCollectCansFromSource(maxCount, excludeSet)
	local result = {}
	excludeSet = excludeSet or {}
	local folder = workspace:FindFirstChild("AllMountainDew")
	if not folder then return result end

	local function consider(p)
		if #result >= maxCount then return end
		if not (p and p:IsA("BasePart") and p.Parent) then return end
		if p.Anchored then return end
		if excludeSet[p] then return end
		if unanchoredIsSwordPart(p) or unanchoredIsAssignedExtraPart(p) then return end
		if not unanchoredPartMatchesCanSize(p) then return end
		local model = p:FindFirstAncestorOfClass("Model")
		if model and Players:GetPlayerFromCharacter(model) then return end
		local massOk = true
		pcall(function()
			if p.AssemblyMass == math.huge then massOk = false end
		end)
		if not massOk then return end
		excludeSet[p] = true
		table.insert(result, p)
	end

	if folder:IsA("BasePart") then consider(folder) end
	for _, d in ipairs(folder:GetDescendants()) do
		if #result >= maxCount then break end
		consider(d)
	end
	return result
end

local function collectUnanchoredParts(center, range, maxCount, excludeChars, partSize)
	local result = {}
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local exclude = {}
	if excludeChars then
		for _,c in ipairs(excludeChars) do
			if c then table.insert(exclude, c) end
		end
	end
	if workspace.Terrain then table.insert(exclude, workspace.Terrain) end
	params.FilterDescendantsInstances = exclude
	
	
	range = math.max(0, tonumber(range) or 0)
	local budget = 512
	if range > 200 then
		budget = math.clamp(math.floor(512 + (range - 200) * 2), 512, 4096)
	end
	params.MaxParts = budget

	local ok, parts = pcall(function()
		return workspace:GetPartBoundsInRadius(center, range, params)
	end)
	if not ok or type(parts) ~= "table" then return result end

	local seen = {}
	partSize = partSize or UnanchoredReanimator.PartSize or 1
	for _, p in ipairs(parts) do
		if #result >= maxCount then break end
		if p and p.Parent and p:IsA("BasePart") and not p.Anchored and not seen[p] then
			if unanchoredIsSwordPart(p) or unanchoredIsAssignedExtraPart(p) then
				
			elseif (not UnanchoredReanimator.CanMode) and unanchoredIsWeldedToOthers(p) then
				
			elseif unanchoredPartMatchesSize(p, partSize) then
				local model = p:FindFirstAncestorOfClass("Model")
				local isPlayerPart = false
				if model and Players:GetPlayerFromCharacter(model) then
					isPlayerPart = true
				end
				if not isPlayerPart and p.AssemblyMass ~= math.huge then
					seen[p] = true
					table.insert(result, p)
				end
			end
		end
	end
	return result
end

local function unanchoredCleanupInvisible()
	for _, c in ipairs(UnanchoredReanimator._invisConns) do
		pcall(function() c:Disconnect() end)
	end
	table.clear(UnanchoredReanimator._invisConns)
	UnanchoredReanimator._invisChar = nil
	UnanchoredReanimator._invisMotorConn = nil
	unanchoredRestoreRealCollisions()
end

local function unanchoredApplyInvisToCharacter(nc)
	if not nc then return end
	UnanchoredReanimator._invisChar = nc

	local h = nc:WaitForChild("Humanoid", 8)
	if not h then return end

	local a1 = h:WaitForChild("Animator", 5)
	if a1 then pcall(function() a1:Destroy() end) end

	local a2 = nc:WaitForChild("Animate", 5)
	if a2 then pcall(function() a2:Destroy() end) end

	pcall(function() nc:WaitForChild("Head", 5) end)

	
	if UnanchoredReanimator._invisMotorConn then
		pcall(function() UnanchoredReanimator._invisMotorConn:Disconnect() end)
		UnanchoredReanimator._invisMotorConn = nil
	end

	local motorConn = RunService.Heartbeat:Connect(function()
		if not UnanchoredReanimator.Running or not UnanchoredReanimator.StayInvisible then return end
		if not nc or not nc.Parent then return end
		for _, v in ipairs(nc:GetDescendants()) do
			if v:IsA("Motor6D") then
				if v.Name == "RootJoint" or v.Name == "Neck" then
					
				else
					pcall(function()
						if type(sethiddenproperty) == "function" then
							sethiddenproperty(v, "ReplicateCurrentAngle6D", Vector3.new(0/0, 0/0, 0/0))
						end
					end)
				end
			end
		end
	end)
	UnanchoredReanimator._invisMotorConn = motorConn
	table.insert(UnanchoredReanimator._invisConns, motorConn)
end

local function unanchoredSetupInvisible()
	unanchoredCleanupInvisible()
	if not UnanchoredReanimator.StayInvisible then return end

	
	
	local caConn = Player.CharacterAdded:Connect(function(nc)
		if not UnanchoredReanimator.Running or not UnanchoredReanimator.StayInvisible then return end
		task.spawn(function()
			unanchoredApplyInvisToCharacter(nc)
		end)
	end)
	table.insert(UnanchoredReanimator._invisConns, caConn)

	local oldChar = Player.Character
	unanchoredForceKillCharacter()

	task.spawn(function()
		
		local nc = nil
		local waited = false
		if oldChar then
			local deadline = tick() + 8
			while tick() < deadline and UnanchoredReanimator.Running and UnanchoredReanimator.StayInvisible do
				if Player.Character and Player.Character ~= oldChar then
					nc = Player.Character
					waited = true
					break
				end
				task.wait(0.05)
			end
		end
		if not nc then
			local ok, result = pcall(function()
				return Player.CharacterAdded:Wait()
			end)
			if ok then nc = result end
		end
		if not nc then
			nc = Player.Character
		end
		if nc and UnanchoredReanimator.Running and UnanchoredReanimator.StayInvisible then
			unanchoredApplyInvisToCharacter(nc)
		elseif Player.Character and UnanchoredReanimator.Running and UnanchoredReanimator.StayInvisible then
			
			unanchoredApplyInvisToCharacter(Player.Character)
		end
	end)
end

