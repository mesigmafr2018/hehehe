local function unanchoredRefreshSlotCache(char, scale)
	scale = math.max(tonumber(scale) or 1, 0.05)
	local s = scale
	local cfs = {}
	local function cfOf(name)
		local p = unanchoredBodyPart(char, name)
		return p and p.CFrame or nil
	end
	local head = cfOf("Head")
	local upperTorso = cfOf("UpperTorso")
	local isR15 = upperTorso ~= nil
	local hrp = cfOf("HumanoidRootPart") or head or CFrame.new()

	cfs[1] = head or hrp

	if isR15 then
		local lowerTorso = cfOf("LowerTorso")
		cfs[2] = upperTorso and (upperTorso * CFrame.new(-0.5 * s, 0.25 * s, 0)) or hrp
		cfs[3] = upperTorso and (upperTorso * CFrame.new( 0.5 * s, 0.25 * s, 0)) or hrp
		cfs[4] = lowerTorso and (lowerTorso * CFrame.new(-0.5 * s, 0, 0))
			or (upperTorso and (upperTorso * CFrame.new(-0.5 * s, -0.5 * s, 0))) or hrp
		cfs[5] = lowerTorso and (lowerTorso * CFrame.new( 0.5 * s, 0, 0))
			or (upperTorso and (upperTorso * CFrame.new( 0.5 * s, -0.5 * s, 0))) or hrp

		local function limbPair(upperName, lowerName, handName)
			local u = cfOf(upperName)
			local l = cfOf(lowerName) or cfOf(handName)
			local upCF, loCF
			if u and l then
				upCF, loCF = u, l
			elseif u then
				upCF = u * CFrame.new(0, 0.5 * s, 0)
				loCF = u * CFrame.new(0, -0.5 * s, 0)
			else
				upCF, loCF = hrp, hrp
			end
			cfs[#cfs + 1] = upCF
			cfs[#cfs + 1] = loCF
		end
		limbPair("LeftUpperArm", "LeftLowerArm", "LeftHand")
		limbPair("RightUpperArm", "RightLowerArm", "RightHand")
		limbPair("LeftUpperLeg", "LeftLowerLeg", "LeftFoot")
		limbPair("RightUpperLeg", "RightLowerLeg", "RightFoot")
	else
		local torso = cfOf("Torso") or hrp
		cfs[2] = torso * CFrame.new(-0.5 * s, 0.5 * s, 0)
		cfs[3] = torso * CFrame.new( 0.5 * s, 0.5 * s, 0)
		cfs[4] = torso * CFrame.new(-0.5 * s, -0.5 * s, 0)
		cfs[5] = torso * CFrame.new( 0.5 * s, -0.5 * s, 0)
		local function r6Limb(name)
			local a = cfOf(name)
			if a then
				cfs[#cfs + 1] = a * CFrame.new(0, 0.5 * s, 0)
				cfs[#cfs + 1] = a * CFrame.new(0, -0.5 * s, 0)
			else
				cfs[#cfs + 1] = hrp
				cfs[#cfs + 1] = hrp
			end
		end
		r6Limb("Left Arm")
		r6Limb("Right Arm")
		r6Limb("Left Leg")
		r6Limb("Right Leg")
	end

	while #cfs < 13 do cfs[#cfs + 1] = hrp end
	for i = 1, 13 do
		if not cfs[i] then cfs[i] = hrp end
	end
	_unanchoredSlotCache.char = char
	_unanchoredSlotCache.scale = scale
	_unanchoredSlotCache.cfs = cfs
	return cfs
end

