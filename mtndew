local function unanchoredAttachCFrame(reanimChar, attach, scale)
	if not reanimChar then return nil end
	scale = scale or 1
	local function gripScale(grip)
		local ok, g = pcall(function()
			if Util and Util.ScaleCFrame then return Util.ScaleCFrame(grip, scale) end
			return CFrame.new(grip.Position * scale) * (grip - grip.Position)
		end)
		return (ok and g) or grip
	end
	if attach == "RightArm" or attach == nil then
		local arm = reanimChar:FindFirstChild("Right Arm")
			or reanimChar:FindFirstChild("RightHand")
			or reanimChar:FindFirstChild("RightLowerArm")
		if arm and arm:IsA("BasePart") then
			return arm.CFrame * gripScale(RIGHTGRIP_C0_UNANCHORED)
		end
	elseif attach == "LeftArm" then
		local arm = reanimChar:FindFirstChild("Left Arm")
			or reanimChar:FindFirstChild("LeftHand")
			or reanimChar:FindFirstChild("LeftLowerArm")
		if arm and arm:IsA("BasePart") then
			return arm.CFrame * gripScale(LEFTGRIP_C0_UNANCHORED)
		end
	elseif attach == "Torso" then
		local t = reanimChar:FindFirstChild("Torso") or reanimChar:FindFirstChild("UpperTorso")
		if t and t:IsA("BasePart") then
			return t.CFrame * CFrame.new(0, 0, -0.5 * scale)
		end
	elseif attach == "Head" then
		local h = reanimChar:FindFirstChild("Head")
		if h and h:IsA("BasePart") then
			return h.CFrame * CFrame.new(0, 0.5 * scale, 0)
		end
	end
	local root = reanimChar:FindFirstChild("HumanoidRootPart")
	if root then
		return root.CFrame * CFrame.new(1 * scale, 0.5 * scale, -1 * scale) * gripScale(RIGHTGRIP_C0_UNANCHORED)
	end
	return nil
end

local function unanchoredParkCFrame(reanimChar, scale)
	scale = scale or 1
	local root = reanimChar and (reanimChar:FindFirstChild("HumanoidRootPart") or reanimChar:FindFirstChild("Torso"))
	
	if root then
		return root.CFrame * CFrame.new(0, 800 * scale, 0)
	end
	return CFrame.new(0, 2000, 0)
end

local function unanchoredExtraTargetCFrame(reanimChar, extra)
	if not (reanimChar and extra) then return nil, false end
	local scale = Reanimate.CharacterScale or 1
	local user = CFrame.new(extra.OffX or 0, extra.OffY or 0, extra.OffZ or 0)
		* CFrame.Angles(math.rad(extra.RotX or 0), math.rad(extra.RotY or 0), math.rad(extra.RotZ or 0))

	local overrides = HatReanimator and HatReanimator.HatCFrameOverride
	local sawGroup, groupDisabled, activeCF = false, false, nil
	if type(overrides) == "table" then
		for _, data in ipairs(overrides) do
			
			
			
			local groupMatch = (data.Group == extra.Name)
			if not groupMatch and extra.Name == "Gun" and data.Group == "Sword" then
				groupMatch = true
			end
			if not groupMatch and extra.Name == "Sword" and data.Group == "Gun" then
				groupMatch = true
			end
			if not groupMatch and extra.Name == "Fire" and (data.Group == "Bullet" or data.Group == "Fire" or data.Group == "Trail") then
				groupMatch = true
			end
			if data and groupMatch then
				sawGroup = true
				if data.Disable then
					groupDisabled = true
				else
					
					if data.CFrame ~= nil and (not data.Limb or data.Group == "Bullet" or data.Group == "Fire" or data.Group == "Trail") then
						local worldCF = data.CFrame * user
						
						
						
						if data.Group == "Bullet" or data.Group == "Fire" or data.Group == "Trail" or extra.Name == "Fire" then
							local root = reanimChar:FindFirstChild("HumanoidRootPart") or reanimChar:FindFirstChild("Torso")
							local p = worldCF.Position
							local isIdleOrbit = false
							if root then
								local offset = p - root.Position
								local horiz = Vector3.new(offset.X, 0, offset.Z).Magnitude
								local s = math.max(scale, 0.25)
								local idleHoriz = 6 * s
								local idleY = -12 * s
								if math.abs(horiz - idleHoriz) < 3 * s and math.abs(offset.Y - idleY) < 5 * s then
									isIdleOrbit = true
								end
							end
							if isIdleOrbit then
								activeCF = unanchoredParkCFrame(reanimChar, scale)
								groupDisabled = true
							else
								activeCF = worldCF
							end
						else
							activeCF = worldCF
						end
					else
						local limbName = data.Limb or "Right Arm"
						local limb = reanimChar:FindFirstChild(limbName)
						if limb and limb:IsA("BasePart") then
							local c0 = data.C0 or data.Offset or CFrame.identity
							local c1 = data.C1 or CFrame.identity
							local sc0, sc1 = c0, c1
							pcall(function()
								if Util and Util.ScaleCFrame then
									sc0 = Util.ScaleCFrame(c0, scale)
									sc1 = Util.ScaleCFrame(c1, scale)
								end
							end)
							activeCF = limb.CFrame * sc0 * sc1:Inverse() * user
						end
					end
				end
			end
		end
	end

	
	if sawGroup and groupDisabled and not activeCF then
		return unanchoredParkCFrame(reanimChar, scale), true
	end
	if activeCF then
		
		local parked = false
		if groupDisabled then
			local root = reanimChar:FindFirstChild("HumanoidRootPart") or reanimChar:FindFirstChild("Torso")
			if root and (activeCF.Position - root.Position).Magnitude > 200 then
				parked = true
			end
		end
		return activeCF, parked
	end

	
	local attach = extra.Attach or "RightArm"
	local arm, gripC0
	if attach == "LeftArm" then
		arm = reanimChar:FindFirstChild("Left Arm")
			or reanimChar:FindFirstChild("LeftHand")
			or reanimChar:FindFirstChild("LeftLowerArm")
		gripC0 = LEFTGRIP_C0_UNANCHORED
	else
		arm = reanimChar:FindFirstChild("Right Arm")
			or reanimChar:FindFirstChild("RightHand")
			or reanimChar:FindFirstChild("RightLowerArm")
		gripC0 = RIGHTGRIP_C0_UNANCHORED
	end
	if not (arm and arm:IsA("BasePart")) then
		return unanchoredAttachCFrame(reanimChar, attach, scale), false
	end
	local scaledC0 = gripC0
	pcall(function()
		if Util and Util.ScaleCFrame then
			scaledC0 = Util.ScaleCFrame(gripC0, scale)
		else
			scaledC0 = CFrame.new(gripC0.Position * scale) * (gripC0 - gripC0.Position)
		end
	end)
	return arm.CFrame * scaledC0 * user:Inverse(), false
end

