				if rec.CanQuery ~= nil then part.CanQuery = rec.CanQuery end
			end)
		end
		_unanchoredColSaved[part] = nil
	end
	_unanchoredColChar = nil
end

local function unanchoredSetPhysicsRepRootRef(root, targetPart)
	if not (root and typeof(root) == "Instance") then return false end
	if type(sethiddenproperty) ~= "function" then return false end
	if targetPart == nil then
		pcall(sethiddenproperty, root, "PhysicsRepRootRef", nil)
		return true
	end
	if typeof(targetPart) == "Instance" and targetPart:IsA("Model") then
		targetPart = targetPart:FindFirstChild("HumanoidRootPart")
			or targetPart.PrimaryPart
			or targetPart:FindFirstChildWhichIsA("BasePart")
	end
	if not (targetPart and typeof(targetPart) == "Instance" and targetPart:IsA("BasePart")) then
		return false
	end
	local model = targetPart:FindFirstAncestorOfClass("Model")
	if model then
		local hrp = model:FindFirstChild("HumanoidRootPart")
		if hrp and hrp:IsA("BasePart") then
			targetPart = hrp
		end
	end
	local okH, handle = pcall(function()
		return InstanceHandle.new(targetPart)
	end)
	if not okH or handle == nil then return false end
	return pcall(sethiddenproperty, root, "PhysicsRepRootRef", handle)
end
